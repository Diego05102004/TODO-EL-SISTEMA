# Configuración de variables de entorno para el microservicio de auditoría
# El token se carga desde el archivo .env privado del proyecto.

# El token de analítica se configura en Apache para evitar sobrescribirlo aquí.

# Configuración de errores PHP (ya existente en el sistema)
php_flag display_errors Off
php_flag log_errors On

# Mantener privados los archivos locales de entorno.
<FilesMatch "^\.env$">
    Require all denied
</FilesMatch>
