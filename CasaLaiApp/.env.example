# Configuración JWT
# JWT_SECRET_KEY=<generate-a-new-private-secret>
# JWT_ISSUER=http://localhost/proyecto-casalai-ca/
# JWT_AUDIENCE=proyecto-casalai-ca

# NOTA: Las claves RSA se configuran en src/config/encryptionConfig.js
# RSA_PUBLIC_KEY y RSA_PRIVATE_KEY ya están configuradas

# Configuración de API
# Para desarrollo web local: http://localhost/proyecto-casalai-ca/api
# Para Android Emulator: http://10.0.2.2/proyecto-casalai-ca/api
# Para producción Always Data: https://casalai.alwaysdata.net/api
EXPO_PUBLIC_API_URL=https://casalai.alwaysdata.net/api

# reCAPTCHA v2 Checkbox: la app obtiene el site key desde api/recaptcha_config.php.
# Configura RECAPTCHA_SITE_KEY y RECAPTCHA_SECRET_KEY en api/Config/.env.
# La secret key nunca debe incluirse en la app ni en variables EXPO_PUBLIC_.
EXPO_PUBLIC_RECAPTCHA_DOMAIN=casalai.alwaysdata.net
# Para desarrollo local, usa EXPO_PUBLIC_RECAPTCHA_DOMAIN=localhost.

# Servicios externos
# ANALITICA_PREDICTIVA_URL=http://127.0.0.1:8000
# ANALITICA_PREDICTIVA_TOKEN=<configure-only-on-the-server>
# AUDITOR_RECEPCION_URL=http://127.0.0.1:8000
# AUDITOR_RECEPCION_TOKEN=<configure-only-on-the-server>
